# Rust 构建产物
/target/
**/*.rs.bk

# Web 静态发布产物（由 scripts/publish-web.sh 生成）
/dist/

# 示例知识库内嵌的 Git 仓库（内容保留，仓库元数据不入库）
examples/sample-vault/.git/

# 运行时生成的知识库索引（meta.db / tantivy 段文件 / 锁文件）
# CI 会在干净 checkout 上由 scripts/publish-web.sh 自动重建，无需入库
**/.kbindex/

# 系统与编辑器临时文件
.DS_Store
Thumbs.db
*~
.*.swp

# IDE
.idea/
.vscode/
*.iml

# 上游编辑器插件源码同步产物（体积大，不入库）
.plugins/
